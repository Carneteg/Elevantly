{
  "name": "elevantly",
  "version": "0.1.0",
  "private": true,
  "description": "Elevantly — AI-first professionell identitetsplattform. Spegeln v1.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/core && npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify:e2e": "tsx scripts/verify-e2e.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
