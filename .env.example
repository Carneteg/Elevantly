# Kopiera denna fil till apps/web/.env.local och fyll i din egen nyckel.
# Riktiga nycklar committas ALDRIG (se .gitignore). Nyckeln läses bara
# server-side i /api/reflect — den skickas aldrig till klienten.

# Anthropic API-nyckel (Claude är motor #1 i Spegeln v1).
ANTHROPIC_API_KEY=

# Valfritt: vilken Claude-modell som ska driva struktureringen.
# Utelämnas → en förnuftig standard i core (se packages/core/src/ai/claudeEngine.ts).
ANTHROPIC_MODEL=
