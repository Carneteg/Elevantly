# Kopiera denna fil till apps/web/.env.local och fyll i din egen nyckel.
# Riktiga nycklar committas ALDRIG (se .gitignore). Nyckeln läses bara
# server-side i /api/reflect — den skickas aldrig till klienten.

# Sätt EN av nycklarna nedan. Finns båda väljs OpenAI om inget annat anges.

# --- OpenAI (GPT) ---
OPENAI_API_KEY=
# Valfritt: OpenAI-modell. Utelämnas → gpt-4o (se packages/core/src/ai/gptEngine.ts).
OPENAI_MODEL=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Valfritt: Claude-modell. Utelämnas → claude-sonnet-5 (se packages/core/src/ai/claudeEngine.ts).
ANTHROPIC_MODEL=

# Valfritt: tvinga motor oavsett vilka nycklar som finns: "openai" eller "claude".
# Utelämnas → härleds ur vilken nyckel som är satt (OpenAI först).
AI_PROVIDER=
